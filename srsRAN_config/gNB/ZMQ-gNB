cu_cp:
  amf:
    addr: 127.0.0.5
    bind_addr: 127.0.0.1
    supported_tracking_areas:
      - tac: 1
        plmn_list:
          - plmn: "00101"
            tai_slice_support_list:
              - sst: 1

cu_up:
  ngu:
    socket:
      - bind_addr: 127.0.0.1

ru_sdr:
  device_driver: zmq
  device_args: tx_port=tcp://127.0.0.1:2000,rx_port=tcp://127.0.0.1:2001,base_srate=23.04e6
  srate: 23.04
  tx_gain: 75
  rx_gain: 75
  time_alignment_calibration: auto

cell_cfg:
  pci: 3
  dl_arfcn: 368500
  band: 3
  common_scs: 15
  channel_bandwidth_MHz: 20
  nof_antennas_dl: 1
  nof_antennas_ul: 1
  plmn: "00101"
  tac: 1

  pdcch:
    common:
      ss0_index: 0
      coreset0_index: 6
    dedicated:
      ss2_type: common
      dci_format_0_1_and_1_1: false

  pdsch:
    mcs_table: qam64

  pusch:
    mcs_table: qam64

log:
  all_level: debug
  filename: /tmp/gnb.log
